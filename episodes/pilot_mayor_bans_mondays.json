{
  "id": "s01e01",
  "title": "THE MAYOR BANS MONDAYS!",
  "logline": "Mayor Winston Boggle abolishes Mondays by decree – until he learns what else happens on a Monday.",
  "structure": {
    "beginning": "Winston announces the ban (cold open).",
    "conflict": "Margaret objects; Winston overrules her with himself.",
    "escalation": "Bins stop, the pub runs dry, Nigel tries to arrest a calendar.",
    "twist": "Council salaries – including the Mayor's – are paid on Mondays.",
    "punchline": "Winston triumphantly 'invents' a brand-new day called Monday."
  },
  "running_gags": [
    "form_27b",
