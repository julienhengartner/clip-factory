# Kopieren nach .env und ausfüllen. .env enthält Geheimnisse: NIE weitergeben, NIE einchecken.
# Alle Werte sind optional – ohne .env läuft die Fabrik komplett kostenlos und lokal.

# ---------------------------------------------------------------------------
# Sicherheitsschalter (Standard: AUS)
# ---------------------------------------------------------------------------
BBOB_ALLOW_PAID_APIS=false          # erlaubt OpenAI/ElevenLabs-Aufrufe (kostet Geld)
BBOB_MAX_PAID_CALLS_PER_DAY=40      # harte Obergrenze pro Tag
BBOB_ALLOW_PUBLISHING=false         # erlaubt Uploads zu TikTok (nur freigegebene Videos)
BBOB_TIKTOK_PUBLISH_MODE=inbox      # inbox = Entwurf in die TikTok-App | direct = Direktveröffentlichung
BBOB_TIKTOK_PRIVACY_LEVEL=SELF_ONLY # bei direct: SELF_ONLY bis die App von TikTok geprüft ist
BBOB_MAX_VIDEOS_PER_DAY=1

# ---------------------------------------------------------------------------
# Anbieter
# ---------------------------------------------------------------------------
BBOB_VOICE_PROVIDER=windows         # windows (kostenlos) | elevenlabs
BBOB_WINDOWS_VOICE=Microsoft Hedda Desktop
BBOB_WINDOWS_VOICE_RATE=2
BBOB_IMAGE_PROVIDER=procedural      # procedural (kostenlos) | openai
BBOB_LLM_PROVIDER=offline           # offline (kostenlos) | openai
BBOB_MUSIC_ENABLED=false            # nur Dateien in assets/music mit <name>.license.txt

# ---------------------------------------------------------------------------
# Videolänge (Standard: Minimum 60 s, ideal bis 75 s, Maximum 80 s)
# ---------------------------------------------------------------------------
# BBOB_MIN_DURATION_S=60
# BBOB_IDEAL_MAX_DURATION_S=75
# BBOB_HARD_MAX_DURATION_S=80

# ---------------------------------------------------------------------------
# Recherche
# ---------------------------------------------------------------------------
# Wikimedia verlangt eine Kontaktangabe (URL oder E-Mail) im User-Agent.
# BBOB_HTTP_USER_AGENT=BuergermeisterBobVideoFactory/0.2 (https://www.instagram.com/buergermeisterbob/) httpx
# Zusätzliche offizielle RSS-Feeds als JSON-Liste, z. B.:
# BBOB_RESEARCH_RSS_FEEDS=["https://www.tagesschau.de/xml/rss2/"]

# ---------------------------------------------------------------------------
# Zugangsdaten
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
BBOB_OPENAI_IMAGE_MODEL=gpt-image-2
BBOB_OPENAI_TEXT_MODEL=gpt-4o-mini

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# BBOB_META_GRAPH_BASE=https://graph.facebook.com/v21.0

# ---------------------------------------------------------------------------
# Oberfläche
# ---------------------------------------------------------------------------
# BBOB_APP_HOST=127.0.0.1           # andere Adressen nur zusammen mit BBOB_APP_TOKEN
# BBOB_APP_PORT=8000
# BBOB_APP_TOKEN=
